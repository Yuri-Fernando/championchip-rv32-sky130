# Build/simulacao
firmware/build/*
!firmware/build/.gitkeep
*.vvp
*.vcd
*.fst

# OpenLane - runs completos e binarios pesados de layout NAO sao versionados
# (dezenas de MB a GB); reproduziveis via `bash scripts/run_openlane.sh`.
# Evidencia versionada: metrics.json, config.json e a imagem PNG do layout
# de cada rodada em docs/evidence/openlane/run_*/.
openlane/runs/
!openlane/runs/.gitkeep
docs/evidence/openlane/*/*.gds
docs/evidence/openlane/*/*.nl.v
docs/evidence/openlane/*/*.gl.v
docs/evidence/openlane/*/sdf/

# SO/editor
.DS_Store
Thumbs.db
*.swp

# Mirror local (fora do repo, mas por seguranca)
/tmp_mirror/

# Saidas intermediarias de simulacao (regeneradas pelos scripts)
build/

__pycache__/
*.pyc

# Material local, fora do repositório e do pacote de entrega:
# planejamento, material do vídeo, pacotes (dist) e o guia oficial (terceiros)
desconsiderar/
dist/

# Dashboard: saída gerada por `make dashboard` (tools/build_dashboard.py)
dashboard/
